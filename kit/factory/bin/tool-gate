#!/usr/bin/env bash
# PreToolUse hook: the factory tool gate (factorylib.toolgate).
#
# Never fails open (rulings R27a, R34): Claude Code treats a hook that exits
# non-zero or prints non-JSON as non-blocking, so this wrapper ALWAYS exits 0.
# If uv or Python fails, or the output is not a hook decision, it prints its own
# decision: deny ("needs human: ...") headless (FACTORY_HEADLESS=1), ask in the
# main session. Empty output with rc 0 is the gate's "defer"; headless it is
# denied, since nothing legitimately defers there.
# ``python -I`` (isolated): neither the cwd (a job worktree) nor PYTHONPATH /
# PYTHON* variables reach sys.path (rulings R38, R40).
# The gate runs under ``timeout`` (25 s, below the 30 s hook timeout), so a hung
# uv or Python is a fallback decision, not a Claude Code hook timeout (which
# would not block). FACTORY_TOOLGATE_TIMEOUT_S may only SHORTEN it (1-24 s).
# Without a ``timeout`` binary (e.g. stock macOS) the gate runs unbounded; its
# own 20 s watchdog still answers.
set -uo pipefail

fallback() {
  local perm=ask reason="factory tool-gate: $1"
  if [ "${FACTORY_HEADLESS:-}" = "1" ]; then
    perm=deny
    reason="needs human: factory tool-gate: $1"
  fi
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"%s","permissionDecisionReason":"%s"}}\n' \
    "$perm" "$reason"
  exit 0
}

here="$(dirname "$(readlink -f "$0")")" || fallback "gate failed (cannot locate wrapper)"
command -v uv >/dev/null 2>&1 || fallback "gate failed (uv not found)"

limit=25
o="${FACTORY_TOOLGATE_TIMEOUT_S:-}"
if [[ "$o" =~ ^[1-9][0-9]?$ ]] && [ "$o" -lt "$limit" ]; then limit="$o"; fi

run=(uv run --quiet --project "$here/.." python -I -m factorylib.toolgate "$@")
if command -v timeout >/dev/null 2>&1; then
  run=(timeout -k 2 "$limit" "${run[@]}")
fi
out="$("${run[@]}")"
rc=$?
[ "$rc" -eq 0 ] || fallback "gate failed (rc=$rc)"
if [ -z "$out" ]; then
  [ "${FACTORY_HEADLESS:-}" = "1" ] && fallback "gate failed (no decision)"
  exit 0  # main session: defer to Claude Code's normal permission flow
fi
case "$out" in
  '{"hookSpecificOutput"'*) printf '%s\n' "$out" ;;
  *) fallback "gate failed (unparsable output)" ;;
esac
exit 0

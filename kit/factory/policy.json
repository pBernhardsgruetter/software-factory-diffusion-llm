{
  "escalate_paths": [
    "package.json",
    "**/package.json",
    "**/package-lock.json",
    "**/npm-shrinkwrap.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/*.lock",
    "**/go.sum",
    ".github/**",
    "**/migrations/**",
    "**/auth/**",
    "firestore.rules",
    "storage.rules",
    "**/*.tf",
    "Dockerfile",
    "**/Dockerfile",
    "vercel.json",
    "netlify.toml",
    "scripts/**",
    "**/scripts/**",
    "**/bun.lockb",
    "**/Dockerfile.*",
    "**/Containerfile",
    "**/docker-compose*.yml",
    "**/docker-compose*.yaml",
    "**/compose*.yml",
    "**/.github/**",
    "**/compose*.yaml"
  ],
  "tool_allow": [
    {
      "argv": [
        "git",
        "status"
      ],
      "flags": [
        "--porcelain",
        "--short",
        "-s",
        "-b",
        "--branch"
      ],
      "paths": true
    },
    {
      "argv": [
        "git",
        "diff"
      ],
      "flags": [
        "--stat",
        "--name-only",
        "--name-status",
        "--oneline",
        "--cached",
        "--staged",
        "--no-color",
        "--"
      ],
      "number_flags": [
        "-n"
      ],
      "paths": true,
      "revs": true
    },
    {
      "argv": [
        "git",
        "log"
      ],
      "flags": [
        "--stat",
        "--name-only",
        "--name-status",
        "--oneline",
        "--cached",
        "--staged",
        "--no-color",
        "--"
      ],
      "number_flags": [
        "-n"
      ],
      "paths": true,
      "revs": true
    },
    {
      "argv": [
        "git",
        "show"
      ],
      "flags": [
        "--stat",
        "--name-only",
        "--name-status",
        "--oneline",
        "--cached",
        "--staged",
        "--no-color",
        "--"
      ],
      "number_flags": [
        "-n"
      ],
      "paths": true,
      "revs": true
    },
    {
      "argv": [
        "git",
        "branch",
        "--show-current"
      ]
    },
    {
      "argv": [
        "git",
        "add"
      ],
      "paths": true,
      "min_extra": 1
    },
    {
      "argv": [
        "npm",
        "test"
      ]
    },
    {
      "argv": [
        "npm",
        "ci"
      ]
    },
    {
      "argv": [
        "npm",
        "run",
        "build"
      ]
    },
    {
      "argv": [
        "npm",
        "run",
        "lint"
      ]
    },
    {
      "argv": [
        "npm",
        "run",
        "test"
      ]
    },
    {
      "argv": [
        "npx",
        "eslint"
      ],
      "flags": [
        "--fix"
      ],
      "paths": true
    },
    {
      "argv": [
        "npx",
        "vitest",
        "run"
      ],
      "paths": true
    },
    {
      "argv": [
        "node",
        "--test"
      ],
      "paths": true
    },
    {
      "argv": [
        "ls"
      ],
      "flags": [
        "-l",
        "-a",
        "-la",
        "-al"
      ],
      "paths": true
    },
    {
      "argv": [
        "cat"
      ],
      "paths": true,
      "min_extra": 1
    }
  ],
  "tool_deny": [
    "\\bsudo\\b",
    "\\bchmod -R 777\\b",
    "\\bnpm publish\\b",
    "\\bfirebase deploy\\b"
  ],
  "guarded_paths": [
    ".claude",
    ".claude/**",
    ".git",
    ".git/**",
    "factory/bin/**",
    "factory/policy.json",
    "factory/config.json",
    "factory/factorylib/**",
    ".husky/**",
    ".mcp.json",
    "CLAUDE.md",
    "AGENTS.md",
    "**/CLAUDE.md",
    "**/AGENTS.md"
  ]
}

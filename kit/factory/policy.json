{
  "escalate_paths": [
    "package.json",
    "**/package.json",
    "**/package-lock.json",
    "**/npm-shrinkwrap.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/*.lock",
    "**/go.sum",
    ".github/**",
    "**/migrations/**",
    "**/auth/**",
    "firestore.rules",
    "storage.rules",
    "**/*.tf",
    "Dockerfile",
    "**/Dockerfile",
    "vercel.json",
    "netlify.toml",
    "scripts/**",
    "**/scripts/**"
  ],
  "tool_allow": [
    "git (?:(?:status|diff|log|show)(?: .*)?|branch --show-current)",
    "git add [^\\s-]\\S*(?: [^\\s-]\\S*)*",
    "git commit -m (?:\"[^\"]*\"|'[^']*'|[^\\s\"'-]\\S*)",
    "npm (test|run (build|lint|test))( .*)?",
    "npm ci",
    "npx eslint (?![-/~])(?!(?:.*[ /])?\\.\\.(?:[ /]|$))(?!.* [/~]).*",
    "npx vitest( run)?( .*)?",
    "ls( .*)?",
    "cat [^|;&]*",
    "node --test( .*)?"
  ],
  "tool_deny": [
    "\\bgit( -\\S+( \\S+)?)* push\\b",
    "\\bgit( -\\S+( \\S+)?)* reset( \\S+)* --hard\\b",
    "\\bgit( -\\S+( \\S+)?)* clean( \\S+)* (-[a-zA-Z]*f|--force)",
    "\\brm(?=(?: \\S+)* -(?:[a-zA-Z]*[rR][a-zA-Z]*|-recursive)(?: |$))(?: \\S+)* [\"']?(/|~|\\$HOME|\\$\\{HOME\\}|\\.\\.|\\./\\.\\.)",
    "\\bcurl\\b.*\\|\\s*(ba|z|da|k)?sh\\b",
    "\\bwget\\b.*\\|\\s*(ba|z|da|k)?sh\\b",
    "\\bsudo\\b",
    "\\bchmod -R 777\\b",
    "\\bnpm publish\\b",
    "\\bfirebase deploy\\b",
    "\\bgit\\b.* --output(?![\\w-])",
    "\\beslint\\b.* (?:-[a-zA-Z]*o|--output-file)(?![\\w-])"
  ],
  "guarded_paths": [
    ".claude",
    ".claude/**",
    ".git",
    ".git/**",
    "factory/bin/**",
    "factory/policy.json",
    "factory/config.json",
    "factory/factorylib/**"
  ]
}
